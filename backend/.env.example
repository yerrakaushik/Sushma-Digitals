# Sushma Digitals Backend — Environment Variables
# Copy this to .env and fill in your real credentials

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Secret token for admin API routes
ADMIN_SECRET=sushma2024admin

# CallMeBot — Free WhatsApp notifications to admin
# Setup: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=91XXXXXXXXXX
CALLMEBOT_APIKEY=your_callmebot_apikey
ADMIN_WHATSAPP=91XXXXXXXXXX

# Cloudinary — Media storage for wish photos/videos
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
